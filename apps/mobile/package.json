{
  "name": "@siltflow/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build": "expo run:android --variant release",
    "build:android": "expo run:android --variant release",
    "build:ios": "expo run:ios --configuration Release",
    "build:web": "expo export --platform web",
    "build:android:cloud": "eas build --platform android",
    "build:ios:cloud": "eas build --platform ios",
    "build:cloud": "eas build --platform all",
    "build:android:cloud:preview": "eas build --platform android --profile preview",
    "build:ios:cloud:preview": "eas build --platform ios --profile preview",
    "build:android:cloud:dev": "eas build --platform android --profile development",
    "build:ios:cloud:dev": "eas build --platform ios --profile development"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@siltflow/shared-db": "workspace:*",
    "@siltflow/shared-lib": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "fuse.js": "7.5.0",
    "nativewind": "5.0.0-preview.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "ts-fsrs": "^5.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "^21.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3"
  }
}
